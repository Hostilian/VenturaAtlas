# Venture Atlas OS — Provider API Keys
# Copy this file to .env and fill in your keys.
# The system will work without all keys — it falls back to Own Orchestrator (always free).

# ── Tier 1: Hermes via Ollama (LOCAL, FREE) ───────────────────────────────────
# Install Ollama from https://ollama.com then: ollama pull hermes3
OLLAMA_BASE_URL=http://localhost:11434
HERMES_MODEL=hermes3:latest
# Fallback if hermes3 not available:
OLLAMA_FALLBACK_MODEL=llama3.1:latest

# ── Tier 2: OmniRoute / OpenRouter (FREE TIER AVAILABLE) ─────────────────────
# Sign up free at https://openrouter.ai — free models: meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_API_KEY=sk-or-...
OMNIROUTE_BASE_URL=https://openrouter.ai/api/v1
OMNIROUTE_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── Tier 3: FCC Claude (Anthropic Haiku — cheapest paid, ~$0.0001/idea) ───────
# Get key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
FCC_CLAUDE_MODEL=claude-haiku-4-5

# ── Tier 5: Full Anthropic (Sonnet/Opus) ─────────────────────────────────────
ANTHROPIC_FULL_MODEL=claude-sonnet-4-5

# ── Daemon & Promotion Settings ───────────────────────────────────────────────
AUTO_PROMOTE_THRESHOLD=85
DAEMON_INTERVAL_SECONDS=120
DAEMON_MAX_ITERATIONS=50
IDEAS_PER_ITERATION=3
LOG_LEVEL=INFO
