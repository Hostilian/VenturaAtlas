# Venture Atlas OS — Provider API Keys & Settings
# Copy this file to .env and fill in your keys.
# The system works without API keys — it falls back to Own Orchestrator (always free).

# ── Tier 1: Hermes via Ollama (LOCAL, FREE) ───────────────────────────────────
# Install Ollama from https://ollama.com then: ollama pull hermes3
OLLAMA_BASE_URL=http://localhost:11434
HERMES_MODEL=hermes3:latest
OLLAMA_FALLBACK_MODEL=llama3.1:latest

# ── Tier 2: OmniRoute / OpenRouter (FREE TIER AVAILABLE) ─────────────────────
# Multi-key pool support: comma-separated list of keys
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2
OPENROUTER_API_KEY=sk-or-...
OMNIROUTE_BASE_URL=https://openrouter.ai/api/v1
OMNIROUTE_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── Tier 3: FCC Claude (Anthropic Haiku) ──────────────────────────────────────
# Multi-key pool support: comma-separated list of keys
ANTHROPIC_API_KEYS=sk-ant-key1,sk-ant-key2
ANTHROPIC_API_KEY=sk-ant-...
FCC_CLAUDE_MODEL=claude-haiku-4-5

# ── Tier 4: Active API (PekPik Gemini 2.5 Flash Proxy) ────────────────────────
ACTIVE_API_KEYS=sk-act-key1,sk-act-key2
ACTIVE_API_KEY=sk-act-...
ACTIVE_API_BASE_URL=https://aiapiv2.pekpik.com/v1
ACTIVE_API_MODEL=gemini-2.5-flash

# ── Tier 5: DeepSeek API ──────────────────────────────────────────────────────
DEEPSEEK_API_KEYS=sk-ds-key1,sk-ds-key2
DEEPSEEK_API_KEY=sk-ds-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── Tier 6: Full Anthropic (Sonnet / Opus) ────────────────────────────────────
ANTHROPIC_FULL_MODEL=claude-sonnet-4-5

# ── Daemon & Promotion Settings ───────────────────────────────────────────────
AUTO_PROMOTE_THRESHOLD=85
DAEMON_INTERVAL_SECONDS=120
DAEMON_MAX_ITERATIONS=50
IDEAS_PER_ITERATION=3
LOG_LEVEL=INFO
