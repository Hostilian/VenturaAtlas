{
  "schemaVersion": "2.0.0",
  "circuitBreaker": {
    "defaultFailureThreshold": 3,
    "defaultCooldownSeconds": 180
  },
  "providers": {
    "nvidia-nim": {
      "name": "NVIDIA NIM",
      "tier": 1,
      "local": false,
      "requiresApiKey": true,
      "keyPoolEnv": "NVIDIA_NIM_API_KEYS",
      "legacyKeyEnv": "NVIDIA_NIM_API_KEY",
      "baseUrlEnv": "NVIDIA_NIM_BASE_URL",
      "modelEnv": "NVIDIA_NIM_MODEL",
      "defaultBaseUrl": "https://integrate.api.nvidia.com/v1",
      "defaultModel": "meta/llama-3.1-8b-instruct",
      "capabilities": ["classification", "reasoning", "coding", "research_synthesis"],
      "costClass": 1,
      "latencyClass": "fast",
      "webAccess": false,
      "executionScopes": ["local-windows", "cloud", "self-hosted"],
      "circuitThreshold": 3,
      "cooldownSeconds": 180
    },
    "cohere-api": {
      "name": "Cohere API",
      "tier": 1,
      "local": false,
      "requiresApiKey": true,
      "keyPoolEnv": "COHERE_API_KEYS",
      "legacyKeyEnv": "COHERE_API_KEY",
      "baseUrlEnv": "COHERE_BASE_URL",
      "defaultBaseUrl": "https://api.cohere.com/v1",
      "capabilities": ["classification", "reasoning", "research_synthesis", "writing_review"],
      "costClass": 1,
      "latencyClass": "fast",
      "webAccess": false,
      "executionScopes": ["local-windows", "cloud", "self-hosted"],
      "circuitThreshold": 3,
      "cooldownSeconds": 180
    },
    "hermes-ollama": {
      "name": "Hermes 3 via Ollama",
      "tier": 1,
      "local": true,
      "requiresApiKey": false,
      "baseUrlEnv": "OLLAMA_BASE_URL",
      "modelEnv": "HERMES_MODEL",
      "fallbackModelEnv": "OLLAMA_FALLBACK_MODEL",
      "defaultBaseUrl": "http://localhost:11434",
      "defaultModel": "hermes3:latest",
      "fallbackModel": "llama3.1:latest",
      "capabilities": ["classification", "tagging", "extraction", "normalization", "reasoning", "research_synthesis"],
      "costClass": 0,
      "latencyClass": "fast",
      "webAccess": false,
      "executionScopes": ["local-windows", "self-hosted", "cloud"],
      "circuitThreshold": 3,
      "cooldownSeconds": 180
    },
    "omniRoute": {
      "name": "OmniRoute / OpenRouter Marketplace",
      "tier": 2,
      "local": false,
      "requiresApiKey": true,
      "keyPoolEnv": "OPENROUTER_API_KEYS",
      "legacyKeyEnv": "OPENROUTER_API_KEY",
      "baseUrlEnv": "OMNIROUTE_BASE_URL",
      "modelEnv": "OMNIROUTE_MODEL",
      "defaultBaseUrl": "https://openrouter.ai/api/v1",
      "defaultModel": "openrouter/free",
      "capabilities": ["comparative_synthesis", "formatting", "research", "coding"],
      "costClass": 1,
      "latencyClass": "medium",
      "webAccess": false,
      "executionScopes": ["local-windows", "cloud", "self-hosted"],
      "circuitThreshold": 3,
      "cooldownSeconds": 180
    },
    "fcc-claude": {
      "name": "FCC Claude (Haiku)",
      "tier": 3,
      "local": false,
      "requiresApiKey": true,
      "keyPoolEnv": "ANTHROPIC_API_KEYS",
      "legacyKeyEnv": "ANTHROPIC_API_KEY",
      "modelEnv": "FCC_CLAUDE_MODEL",
      "defaultModel": "claude-haiku-4-5",
      "capabilities": ["structured_review", "consistency_checking", "schema_analysis", "writing_review", "reasoning", "research_synthesis"],
      "costClass": 1,
      "latencyClass": "fast",
      "webAccess": false,
      "executionScopes": ["local-windows", "cloud", "self-hosted"],
      "circuitThreshold": 3,
      "cooldownSeconds": 180
    },
    "active-api": {
      "name": "Active API (PekPik Gemini Proxy)",
      "tier": 4,
      "local": false,
      "requiresApiKey": true,
      "keyPoolEnv": "ACTIVE_API_KEYS",
      "legacyKeyEnv": "ACTIVE_API_KEY",
      "baseUrlEnv": "ACTIVE_API_BASE_URL",
      "modelEnv": "ACTIVE_API_MODEL",
      "defaultBaseUrl": "https://aiapiv2.pekpik.com/v1",
      "defaultModel": "gemini-2.5-flash",
      "capabilities": ["high_volume_analysis", "structured_extraction", "multimodal", "research_synthesis"],
      "costClass": 1,
      "latencyClass": "fast",
      "webAccess": false,
      "executionScopes": ["local-windows", "cloud", "self-hosted"],
      "circuitThreshold": 3,
      "cooldownSeconds": 180
    },
    "deepseek-api": {
      "name": "DeepSeek API",
      "tier": 5,
      "local": false,
      "requiresApiKey": true,
      "keyPoolEnv": "DEEPSEEK_API_KEYS",
      "legacyKeyEnv": "DEEPSEEK_API_KEY",
      "baseUrlEnv": "DEEPSEEK_BASE_URL",
      "modelEnv": "DEEPSEEK_MODEL",
      "defaultBaseUrl": "https://api.deepseek.com/v1",
      "defaultModel": "deepseek-chat",
      "capabilities": ["reasoning", "adversarial_review", "coding", "algorithm_review"],
      "costClass": 1,
      "latencyClass": "medium",
      "webAccess": false,
      "executionScopes": ["local-windows", "cloud", "self-hosted"],
      "circuitThreshold": 3,
      "cooldownSeconds": 180
    },
    "anthropic-full": {
      "name": "Full Anthropic (Sonnet / Opus)",
      "tier": 6,
      "local": false,
      "requiresApiKey": true,
      "keyPoolEnv": "ANTHROPIC_API_KEYS",
      "legacyKeyEnv": "ANTHROPIC_API_KEY",
      "modelEnv": "ANTHROPIC_FULL_MODEL",
      "defaultModel": "claude-sonnet-4-5",
      "capabilities": ["architecture", "security_analysis", "complex_synthesis", "high_risk_code_review"],
      "costClass": 3,
      "latencyClass": "medium",
      "webAccess": false,
      "executionScopes": ["local-windows", "cloud", "self-hosted"],
      "circuitThreshold": 3,
      "cooldownSeconds": 180
    },
    "nvidia-nim-adversarial": {
      "name": "NVIDIA NIM Adversarial Lane (OpenAI GPT-OSS 20B)",
      "tier": 2,
      "local": false,
      "requiresApiKey": true,
      "keyPoolEnv": "NVIDIA_NIM_API_KEYS",
      "legacyKeyEnv": "NVIDIA_NIM_API_KEY",
      "baseUrlEnv": "NVIDIA_NIM_BASE_URL",
      "modelEnv": "NVIDIA_NIM_ADVERSARIAL_MODEL",
      "defaultBaseUrl": "https://integrate.api.nvidia.com/v1",
      "defaultModel": "openai/gpt-oss-20b",
      "infrastructureGroup": "nvidia-nim",
      "capabilities": ["reasoning", "structured_review", "adversarial_review", "research_synthesis"],
      "costClass": 1,
      "latencyClass": "medium",
      "webAccess": false,
      "executionScopes": ["cloud"],
      "circuitThreshold": 3,
      "cooldownSeconds": 180
    },
    "own-orch": {
      "name": "Own Deterministic Orchestrator",
      "tier": 0,
      "local": true,
      "requiresApiKey": false,
      "defaultModel": "rule-based-v2",
      "capabilities": ["fallback", "deterministic_generation", "schema_normalization", "offline_guarantee"],
      "costClass": 0,
      "latencyClass": "instant",
      "webAccess": false,
      "executionScopes": ["local-windows", "cloud", "self-hosted"],
      "circuitThreshold": 999,
      "cooldownSeconds": 0
    }
  }
}
