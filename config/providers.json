      "productionEligible": false,
      "defaultModel": "hermes3:latest",
      "fallbackModel": "llama3.1:latest",
      "requiresApiKey": false
    },
    "omniRoute": {
      "name": "OmniRoute / OpenRouter",
      "tier": 2,
      "localOnly": false,
      "productionEligible": true,
      "defaultModel": "meta-llama/llama-3.1-8b-instruct:free",
