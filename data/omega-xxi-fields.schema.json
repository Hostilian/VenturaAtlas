{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://venture-atlas.local/schemas/omega-xxi-fields.schema.json",
  "title": "OMEGA XXI failure-surface opportunity",
  "type": "object",
  "required": [
    "slug",
    "implementation_readiness_level",
    "spec_freeze_index",
    "failure_surface_score",
    "failure_cost_score",
    "government_substitution_score",
    "open_source_compression_score",
    "hyperscaler_absorption_score",
    "certification_boundary_score",
    "continuous_conformance_score",
    "state_machine_complexity",
    "evidence_retention_years",
    "official_sandbox_available",
    "official_production_api",
    "official_test_requirement",
    "regulatory_outage_risk",
    "schema_change_frequency",
    "semantic_change_frequency",
    "customer_transaction_volume",
    "partner_distribution_multiplier",
    "integration_depth",
    "technical_liability_boundary",
    "human_approval_requirement"
  ],
  "properties": {
    "slug": {"type": "string", "minLength": 3},
    "implementation_readiness_level": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "spec_freeze_index": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "failure_surface_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "failure_cost_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "government_substitution_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "open_source_compression_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "hyperscaler_absorption_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "certification_boundary_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "continuous_conformance_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "state_machine_complexity": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "evidence_retention_years": {"type": ["number", "null"], "minimum": 0},
    "official_sandbox_available": {"type": ["boolean", "null"]},
    "official_production_api": {"type": ["boolean", "null"]},
    "official_test_requirement": {"enum": [true, false, "unverified", null]},
    "regulatory_outage_risk": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "schema_change_frequency": {"enum": ["none", "low", "medium", "high", "unknown", null]},
    "semantic_change_frequency": {"enum": ["none", "low", "medium", "high", "unknown", null]},
    "customer_transaction_volume": {"enum": ["one_off", "low", "medium", "high", "unknown", null]},
    "partner_distribution_multiplier": {"type": ["number", "null"], "minimum": 0},
    "integration_depth": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "technical_liability_boundary": {"enum": ["clear", "partly_clear", "unclear", "legal_advice_risk", null]},
    "human_approval_requirement": {"enum": ["always", "conditional", "optional", "none", "unknown", null]}
  },
  "additionalProperties": true
}

