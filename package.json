{
  "name": "venture-atlas-os",
  "version": "2.7.1",
  "private": true,
  "description": "Static evidence-aware venture idea research repository and GitHub Pages site",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean-generated.js",
    "format": "node scripts/check-format.js --write",
    "format:check": "node scripts/check-format.js",
    "lint": "npm run check:eslint && npm run check:stylelint && npm run check-python && npm run format:check",
    "typecheck": "tsc -p apps/factbounty/tsconfig.json",
    "validate": "npm run validate:source",
    "validate:source": "npm run validate:data && npm run validate:links",
    "validate:data": "node scripts/validate-data.js --strict --check && python scripts/validate-schema.py && node scripts/build-idea-taxonomy.js --check && python scripts/build-research-proposal-catalog.py && python scripts/validate-proofops.py && python scripts/validate-machine-rights.py && node scripts/validate-authority-registries.js && node scripts/validate-lifecycle-receipts.js && node scripts/validate-shockgraph.js && node scripts/validate-phaseshift.js && node scripts/build-phase-forward-counterfactuals.js && node scripts/validate-validation-funnel.js && node scripts/validate-capital-clock.js && node scripts/validate-capital-clock-ledger.js && node scripts/validate-cutover-inventory-clock.js && node scripts/validate-absorption-frontier.js && npm run validate:mercury && npm run validate:commercial-reality && node scripts/validate-terrain.js --check && npm run validate:chessboard && npm run validate:census",
    "validate:terrain": "node scripts/validate-terrain.js --check",
    "validate:lifecycle": "node scripts/validate-lifecycle-receipts.js",
    "validate:shockgraph": "node scripts/validate-shockgraph.js",
    "validate:phaseshift": "node scripts/validate-phaseshift.js && node scripts/build-phase-forward-counterfactuals.js",
    "validate:completion": "node scripts/validate-completion-audit.js",
    "validate:mercury": "node scripts/validate-mercury.js",
    "validate:commercial-reality": "node scripts/validate-commercial-reality.js",
    "validate:chessboard": "node scripts/validate-chessboard.js",
    "validate:links": "node scripts/check-links.js",
    "validate:public": "node scripts/check-public-artifact.js",
    "validate:deploy": "node scripts/check-public-artifact.js",
    "reconcile:truth": "node scripts/truth-reconciler.js",
    "generate": "npm run generate:taxonomy && npm run generate:search && npm run generate:status && npm run generate:terrain",
    "generate:taxonomy": "node scripts/build-idea-taxonomy.js",
    "generate:search": "node scripts/build-search-index.js",
    "generate:terrain": "node scripts/build-terrain-index.js",
    "generate:status": "node scripts/build-repository-meta.js && node scripts/update-documentation-stats.js",
    "generate:projections": "npm run generate:status",
    "check:projections": "node scripts/build-repository-meta.js --check && node scripts/update-documentation-stats.js --check",
    "build": "npm run generate && npm run build:site",
    "build:search": "node scripts/build-search-index.js",
    "build:stats": "node scripts/build-repository-meta.js",
    "build-site": "node scripts/build-public-artifact.js",
    "build:site": "node scripts/build-public-artifact.js",
    "build:verified": "npm run clean && npm run generate && npm run build:site && npm run validate:public && npm run test:pwa",
    "test": "npm run test:unit",
    "test:unit": "node --test --test-concurrency=1 tests/*.test.js",
    "test:python": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:race": "node --test tests/id-allocator-race.test.js",
    "test:providers": "python scripts/test_providers_mock.py",
    "smoke:providers": "python scripts/va_orchestrator.py --test",
    "proof:providers:live": "python scripts/live-provider-proof.py --minimum-external 2 --fanout 2 --max-cost 1",
    "preflight:cloud": "python cloud-control-plane/preflight.py",
    "test:runtime": "node --test tests/runtime-contract.test.js",
    "test:pwa": "node --test tests/pwa-contract.test.js",
    "test:integration": "tsx --test apps/factbounty/tests/*.test.ts",
    "test:factbounty": "tsx --test apps/factbounty/tests/*.test.ts",
    "test:e2e": "npx playwright test",
    "test:all": "npm run test:unit && npm run test:race && npm run test:integration",
    "check:generated": "npm run check:drift",
    "check:secrets": "node scripts/check-public-artifact.js",
    "check-task-graph": "node scripts/check-task-graph.js",
    "check:autonomy": "python scripts/check-autonomy-contract.py",
    "quality:fast": "node scripts/run-quality.js fast",
    "quality:agent": "node scripts/run-quality.js agent",
    "quality:deep": "node scripts/run-quality.js deep",
    "quality:source": "node scripts/run-quality.js source",
    "quality:artifact": "node scripts/run-quality.js artifact",
    "quality:fast": "node scripts/run-quality.js fast",
    "quality:agent": "node scripts/run-quality.js agent",
    "quality:deep": "node scripts/run-quality.js deep",
    "quality:release": "node scripts/run-quality.js release",
    "quality:gate": "node scripts/run-quality.js gate",
    "quality:fix": "node scripts/run-quality.js fix --interactive",
    "quality": "npm run quality:fast && npm run quality:agent",
    "check:eslint": "node scripts/check-eslint.js",
    "check:stylelint": "node scripts/check-stylelint.js",
    "check:duplicates": "node scripts/check-duplicates.js",
    "check:unused": "node scripts/check-unused.js",
    "check:bugs": "node scripts/check-sentry.js",
    "check:browser": "node scripts/agent-browser.js",
    "check:inventory": "node scripts/build-component-inventory.js --check",
    "check:knip": "node scripts/check-knip.js",
    "check:jscpd": "node scripts/check-jscpd.js",
    "check:fallow": "node scripts/check-fallow.js",
    "check:css-metrics": "node scripts/check-css-metrics.js",
    "check:ai-antipatterns": "node scripts/validate-ai-antipatterns.js",
    "check:design-tokens": "node scripts/validate-design-tokens.js",
    "check:todos": "node scripts/validate-todos.js",
    "check:smoke": "node scripts/lightpanda-smoke.js",
    "resolve:next-task": "node scripts/resolve-next-task.js",
    "task": "node scripts/task.js",
    "view:dex": "node scripts/dex-adapter.js",
    "view:beads": "node scripts/beads-adapter.js",
    "lint:eslint": "eslint scripts/ services/ assets/js/ apps/ tests/",
    "lint:stylelint": "stylelint \"assets/css/**/*.css\"",
    "ci": "npm run clean && npm run typecheck && npm run validate:source && npm run test:unit && npm run build && npm run validate:public",
    "ci:full": "npm run quality:release && npm run test:race && npm run test:providers && npm run test:e2e",
    "check-js": "node scripts/check-js-syntax.js",
    "check-python": "python scripts/check_python_syntax.py",
    "check-links": "node scripts/check-links.js",
    "check-consistency": "node scripts/check-repository-consistency.js",
    "check:drift": "node scripts/check-repository-drift.js",
    "check:artifact": "node scripts/check-public-artifact.js",
    "agents:status": "node scripts/agents-status.js",
    "agents:watch": "node scripts/agents-watch.js",
    "agents:health": "node scripts/agents-health.js",
    "agents:graph": "node scripts/agents-graph.js",
    "factbounty:start": "tsx apps/factbounty/api/server.ts",
    "factbounty:test": "tsx --test apps/factbounty/tests/*.test.ts",
    "check": "npm run quality:agent",
    "validate:census": "node scripts/validate-census.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1108.0",
    "@aws-sdk/s3-request-presigner": "3.1108.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "4.22.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jose": "5.10.0",
    "stripe": "17.7.0",
    "supertest": "7.2.2",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@projectwallace/css-analyzer": "^9.9.3",
    "@sentry/cli": "^3.7.0",
    "@sentry/node": "^10.72.0",
    "@types/express": "5.0.0",
    "@types/node": "22.13.4",
    "@types/supertest": "6.0.2",
    "eslint": "^9.39.5",
    "fallow": "^3.20.0",
    "jscpd": "^5.0.16",
    "knip": "^5.88.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "^8.68.0"
  }
}
