{
  "name": "venture-atlas-os",
  "version": "2.0.0",
  "private": true,
  "description": "Static evidence-aware venture idea research repository and GitHub Pages site",
  "scripts": {
    "test": "node tests/smoke.test.js",
    "validate": "node scripts/validate-data.js && python scripts/validate-schema.py",
    "check-links": "node scripts/check-links.js",
    "build-search": "node scripts/build-search-index.js",
    "check-js": "node --check assets/js/site.js",
    "agents:status": "node scripts/agents-status.js",
    "agents:watch": "node scripts/agents-watch.js",
    "agents:health": "node scripts/agents-health.js",
    "agents:graph": "node scripts/agents-graph.js",
    "factbounty:start": "npx ts-node -P apps/factbounty/tsconfig.json apps/factbounty/api/server.ts",
    "factbounty:test": "npx ts-node -P apps/factbounty/tsconfig.json apps/factbounty/tests/factbounty.test.ts",
    "test:e2e": "npx ts-node -P apps/factbounty/tsconfig.json apps/factbounty/tests/e2e-playwright.test.ts"
  }
}
