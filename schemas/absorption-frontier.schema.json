{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ventureatlas.local/schemas/absorption-frontier.schema.json",
  "type": "object",
  "required": ["schemaVersion", "runId", "checkedAt", "status", "records"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "minLength": 1 },
    "checkedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["REUNDERWRITE_EXISTING_NOT_CANONICAL_PROMOTION"] },
    "records": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "required": ["frontierId", "ideaRef", "noveltyDistance", "naturalAbsorbers", "residualWork", "residualBuyer", "verdict", "sourceRefs", "confidence"],
        "properties": {
          "frontierId": { "type": "string", "pattern": "^af-[a-z0-9-]+$" },
          "ideaRef": { "type": "string", "minLength": 1 },
          "candidateRef": { "type": ["string", "null"] },
          "noveltyDistance": { "enum": ["EXISTING_IDEA_REUNDERWRITE", "EXISTING_IDEA_UPGRADE", "ARCHIVE_COMPARISON_BASELINE"] },
          "naturalAbsorbers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "absorptionMechanisms": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "absorptionPressure": { "type": "integer", "minimum": 0, "maximum": 100 },
          "controlPointDistance": { "enum": ["DIRECT", "ONE_STEP", "MULTI_SYSTEM", "UNKNOWN"] },
          "residualWork": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "residualBuyer": { "type": ["string", "null"] },
          "failureEvidence": { "type": "array", "items": { "type": "string" } },
          "opportunityHalfLife": { "type": ["string", "null"] },
          "verdict": { "enum": ["RETAIN_FOR_VALIDATION", "REUNDERWRITE_NARROWLY", "ARCHIVE_GENERIC_WEDGE", "WATCH"] },
          "promotionEligible": { "const": false },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "confidence": { "enum": ["low", "medium", "high"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
