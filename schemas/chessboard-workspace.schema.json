{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ventureatlas.local/schemas/chessboard-workspace.schema.json",
  "title": "VenturaAtlas CHESSBOARD market-structure workspace",
  "description": "A private-first, evidence-linked market structure snapshot. This contract represents mechanisms and uncertainty; it does not define or mutate global scores or rankings.",
  "type": "object",
  "required": [
    "schemaVersion",
    "workspaceMode",
    "privacyScope",
    "workspaceId",
    "selectionAuthority",
    "canonicalIdeaId",
    "canonicalIdeaRevision",
    "ventureName",
    "snapshot",
    "marketDefinitions",
    "actors",
    "valueChainLayers",
    "controlPoints",
    "dependencies",
    "ecosystemEdges",
    "responses",
    "strategicClaims",
    "moatMechanisms",
    "antiMoats",
    "commoditizationRisks",
    "events",
    "stressScenarios",
    "positions",
    "researchGaps",
    "handoffs",
    "sourceRecords",
    "legacyScoreAudit"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.1.0" },
    "workspaceMode": {
      "enum": ["PRIVATE_STRATEGY", "PUBLIC_SANITIZED", "UNVERIFIED_DRAFT"]
    },
    "privacyScope": {
      "enum": ["PRIVATE_REPOSITORY_ONLY", "LOCAL_BROWSER_ONLY", "PUBLIC_SANITIZED"]
    },
    "workspaceId": { "type": "string", "pattern": "^chessboard-[a-z0-9-]+$" },
    "selectionAuthority": { "$ref": "#/$defs/selectionAuthority" },
    "canonicalIdeaId": { "$ref": "#/$defs/ideaId" },
    "canonicalIdeaRevision": { "$ref": "#/$defs/sha256" },
    "ventureName": { "type": "string", "minLength": 1 },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "marketDefinitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/marketDefinition" }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actor" }
    },
    "valueChainLayers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/valueChainLayer" }
    },
    "controlPoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/controlPoint" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "ecosystemEdges": {
      "type": "array",
      "items": { "$ref": "#/$defs/ecosystemEdge" }
    },
    "responses": {
      "type": "array",
      "items": { "$ref": "#/$defs/response" }
    },
    "strategicClaims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/strategicClaim" }
    },
    "moatMechanisms": {
      "type": "array",
      "items": { "$ref": "#/$defs/moatMechanism" }
    },
    "antiMoats": {
      "type": "array",
      "items": { "$ref": "#/$defs/antiMoat" }
    },
    "commoditizationRisks": {
      "type": "array",
      "items": { "$ref": "#/$defs/commoditizationRisk" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/marketEvent" }
    },
    "stressScenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/stressScenario" }
    },
    "positions": {
      "type": "array",
      "items": { "$ref": "#/$defs/position" }
    },
    "researchGaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/researchGap" }
    },
    "handoffs": {
      "type": "array",
      "items": { "$ref": "#/$defs/handoff" }
    },
    "sourceRecords": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceRecord" }
    },
    "legacyScoreAudit": { "$ref": "#/$defs/legacyScoreAudit" }
  },
  "additionalProperties": false,
  "$defs": {
    "ideaId": { "type": "string", "pattern": "^idea-[0-9]{3}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "nullableDateTime": {
      "oneOf": [
        { "$ref": "#/$defs/dateTime" },
        { "type": "null" }
      ]
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" }
    },
    "epistemicState": {
      "enum": [
        "OBSERVED_FACT",
        "SOURCE_SUPPORTED_INFERENCE",
        "MODEL_HYPOTHESIS",
        "SCENARIO",
        "USER_ASSUMPTION",
        "UNKNOWN"
      ]
    },
    "confidence": { "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"] },
    "qualitativeLevel": { "enum": ["VERY_LOW", "LOW", "MEDIUM", "HIGH", "VERY_HIGH", "UNKNOWN"] },
    "timeHorizon": { "enum": ["IMMEDIATE", "WEEKS", "MONTHS", "YEARS", "LONG_TERM", "UNKNOWN"] },
    "selectionAuthority": {
      "type": "object",
      "required": [
        "state",
        "authorityPath",
        "activeVentureId",
        "analysisTargetBasis",
        "evaluatedAt",
        "discrepancies",
        "rationale"
      ],
      "properties": {
        "state": {
          "enum": [
            "AUTHORITATIVE_ACTIVE_VENTURE",
            "NO_AUTHORITATIVE_ACTIVE_VENTURE",
            "DISCREPANCY_REQUIRES_RESOLUTION"
          ]
        },
        "authorityPath": { "const": ".agent-system/state.json" },
        "activeVentureId": {
          "oneOf": [
            { "$ref": "#/$defs/ideaId" },
            { "type": "null" }
          ]
        },
        "analysisTargetBasis": {
          "enum": [
            "AUTHORITATIVE_SELECTION",
            "CURRENT_CANONICAL_PRIORITY_RECORD",
            "RECENT_DOMAIN_DOGFOOD",
            "USER_ASSUMPTION",
            "EXPLICIT_NON_AUTHORITATIVE_DOGFOOD"
          ]
        },
        "evaluatedAt": { "$ref": "#/$defs/dateTime" },
        "discrepancies": {
          "type": "array",
          "items": { "$ref": "#/$defs/selectionDiscrepancy" }
        },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "selectionDiscrepancy": {
      "type": "object",
      "required": [
        "discrepancyId",
        "sourcePath",
        "sourceIdeaId",
        "field",
        "sourceValue",
        "canonicalValue",
        "status"
      ],
      "properties": {
        "discrepancyId": { "type": "string", "pattern": "^selection-discrepancy-[a-z0-9-]+$" },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceIdeaId": { "$ref": "#/$defs/ideaId" },
        "field": { "enum": ["selectedIdeaId", "selectedIdeaName", "selectionStatus"] },
        "sourceValue": { "type": ["string", "null"] },
        "canonicalValue": { "type": ["string", "null"] },
        "status": { "enum": ["OPEN", "PRESERVED", "RESOLVED", "SUPERSEDED"] }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": ["snapshotId", "asOf", "status", "priorSnapshotRef", "researchCutoff", "notes"],
      "properties": {
        "snapshotId": { "type": "string", "pattern": "^snapshot-[a-z0-9-]+$" },
        "asOf": { "$ref": "#/$defs/dateTime" },
        "status": { "enum": ["DRAFT", "CURRENT", "SUPERSEDED"] },
        "priorSnapshotRef": { "type": ["string", "null"] },
        "researchCutoff": { "$ref": "#/$defs/dateTime" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "marketDefinition": {
      "type": "object",
      "required": [
        "marketId",
        "name",
        "jobs",
        "buyerActorRefs",
        "budget",
        "includedAlternativeActorRefs",
        "excludedAlternativeActorRefs",
        "reason",
        "confidence",
        "epistemicState",
        "sourceRefs"
      ],
      "properties": {
        "marketId": { "type": "string", "pattern": "^market-[a-z0-9-]+$" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "jobs": { "$ref": "#/$defs/nonEmptyStringArray" },
        "buyerActorRefs": { "$ref": "#/$defs/stringArray" },
        "budget": { "$ref": "#/$defs/nonEmptyString" },
        "includedAlternativeActorRefs": { "$ref": "#/$defs/stringArray" },
        "excludedAlternativeActorRefs": { "$ref": "#/$defs/stringArray" },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "epistemicState": { "$ref": "#/$defs/epistemicState" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" },
        "phaseShiftMarketRef": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": [
        "actorId",
        "name",
        "type",
        "marketRefs",
        "assets",
        "dependencyRefs",
        "controlPointRefs",
        "incentives",
        "observedMoveRefs",
        "epistemicState",
        "sourceRefs"
      ],
      "properties": {
        "actorId": { "type": "string", "pattern": "^actor-[a-z0-9-]+$" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "type": {
          "enum": [
            "VENTURE",
            "CUSTOMER",
            "END_USER",
            "ECONOMIC_BUYER",
            "DIRECT_COMPETITOR",
            "INDIRECT_COMPETITOR",
            "SUBSTITUTE",
            "STATUS_QUO",
            "OPEN_SOURCE_PROJECT",
            "UPSTREAM_SUPPLIER",
            "DOWNSTREAM_DISTRIBUTOR",
            "PLATFORM",
            "GATEKEEPER",
            "COMPLEMENTOR",
            "INTEGRATOR",
            "CHANNEL",
            "STANDARD_BODY",
            "REGULATOR",
            "DATA_PROVIDER",
            "MODEL_PROVIDER",
            "CLOUD_PROVIDER",
            "MARKETPLACE",
            "SYSTEM_OF_RECORD",
            "INTERNAL_BUILD_TEAM",
            "ADJACENT_INCUMBENT",
            "NEW_ENTRANT"
          ]
        },
        "marketRefs": { "$ref": "#/$defs/stringArray" },
        "assets": { "$ref": "#/$defs/stringArray" },
        "dependencyRefs": { "$ref": "#/$defs/stringArray" },
        "controlPointRefs": { "$ref": "#/$defs/stringArray" },
        "incentives": { "$ref": "#/$defs/nonEmptyStringArray" },
        "observedMoveRefs": { "$ref": "#/$defs/stringArray" },
        "epistemicState": { "$ref": "#/$defs/epistemicState" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" },
        "targetBuyer": { "type": "string", "minLength": 1 },
        "coreJob": { "type": "string", "minLength": 1 },
        "pricing": { "type": "string", "minLength": 1 },
        "distribution": { "$ref": "#/$defs/stringArray" },
        "trajectory": { "type": "string", "minLength": 1 },
        "strategicIntent": { "type": "string", "minLength": 1 },
        "openSourceProfile": { "$ref": "#/$defs/openSourceProfile" }
      },
      "additionalProperties": false
    },
    "openSourceProfile": {
      "type": "object",
      "required": [
        "license",
        "repositoryUrl",
        "latestRelease",
        "latestReleaseAt",
        "activity",
        "contributors",
        "releaseCadence",
        "commercialBacking",
        "deploymentBurden",
        "sourceRefs"
      ],
      "properties": {
        "license": { "$ref": "#/$defs/nonEmptyString" },
        "repositoryUrl": { "type": "string", "format": "uri" },
        "latestRelease": { "$ref": "#/$defs/nonEmptyString" },
        "latestReleaseAt": { "$ref": "#/$defs/nullableDateTime" },
        "activity": { "$ref": "#/$defs/nonEmptyString" },
        "contributors": { "$ref": "#/$defs/nonEmptyString" },
        "releaseCadence": { "$ref": "#/$defs/nonEmptyString" },
        "commercialBacking": { "$ref": "#/$defs/nonEmptyString" },
        "deploymentBurden": { "$ref": "#/$defs/nonEmptyString" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      },
      "additionalProperties": false
    },
    "valueChainLayer": {
      "type": "object",
      "required": [
        "layerId",
        "name",
        "sequence",
        "actorRefs",
        "inputs",
        "outputs",
        "economics",
        "switching",
        "concentration",
        "commodityState",
        "controlPointRefs",
        "epistemicState",
        "sourceRefs"
      ],
      "properties": {
        "layerId": { "type": "string", "pattern": "^layer-[a-z0-9-]+$" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "sequence": { "type": "integer", "minimum": 0 },
        "actorRefs": { "$ref": "#/$defs/stringArray" },
        "inputs": { "$ref": "#/$defs/stringArray" },
        "outputs": { "$ref": "#/$defs/stringArray" },
        "economics": { "$ref": "#/$defs/nonEmptyString" },
        "switching": { "$ref": "#/$defs/nonEmptyString" },
        "concentration": { "$ref": "#/$defs/qualitativeLevel" },
        "commodityState": { "enum": ["SCARCE", "CONTESTED", "COMMODITIZING", "COMMODITY_LIKE", "UNKNOWN"] },
        "controlPointRefs": { "$ref": "#/$defs/stringArray" },
        "epistemicState": { "$ref": "#/$defs/epistemicState" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      },
      "additionalProperties": false
    },
    "controlPoint": {
      "type": "object",
      "required": [
        "controlPointId",
        "layerRef",
        "controllerActorRef",
        "controlledResource",
        "dependentActorRefs",
        "mechanism",
        "switchability",
        "alternativeActorRefs",
        "epistemicState",
        "sourceRefs",
        "counterEvidenceRefs"
      ],
      "properties": {
        "controlPointId": { "type": "string", "pattern": "^control-[a-z0-9-]+$" },
        "layerRef": { "type": "string" },
        "controllerActorRef": { "type": "string" },
        "controlledResource": { "$ref": "#/$defs/nonEmptyString" },
        "dependentActorRefs": { "$ref": "#/$defs/stringArray" },
        "mechanism": { "$ref": "#/$defs/nonEmptyString" },
        "switchability": { "$ref": "#/$defs/qualitativeLevel" },
        "alternativeActorRefs": { "$ref": "#/$defs/stringArray" },
        "epistemicState": { "$ref": "#/$defs/epistemicState" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" },
        "counterEvidenceRefs": { "$ref": "#/$defs/sourceRefs" }
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": [
        "dependencyId",
        "dependentActorRefs",
        "providerActorRef",
        "resource",
        "criticality",
        "switchingCost",
        "providerPower",
        "alternativeActorRefs",
        "alternativeDescriptions",
        "contractualConstraints",
        "technicalConstraints",
        "providerEntryRisk",
        "priceExposure",
        "accessExposure",
        "controlPointRef",
        "shockgraphDependencyRef",
        "epistemicState",
        "sourceRefs",
        "counterEvidenceRefs"
      ],
      "properties": {
        "dependencyId": { "type": "string", "pattern": "^dependency-[a-z0-9-]+$" },
        "dependentActorRefs": { "$ref": "#/$defs/nonEmptyStringArray" },
        "providerActorRef": { "type": "string" },
        "resource": { "$ref": "#/$defs/nonEmptyString" },
        "criticality": { "$ref": "#/$defs/qualitativeLevel" },
        "switchingCost": { "$ref": "#/$defs/qualitativeLevel" },
        "providerPower": { "$ref": "#/$defs/qualitativeLevel" },
        "switchingProcess": { "$ref": "#/$defs/switchingProcess" },
        "multiHoming": { "$ref": "#/$defs/multiHoming" },
        "alternativeActorRefs": { "$ref": "#/$defs/stringArray" },
        "alternativeDescriptions": { "$ref": "#/$defs/stringArray" },
        "contractualConstraints": { "$ref": "#/$defs/stringArray" },
        "technicalConstraints": { "$ref": "#/$defs/stringArray" },
        "providerEntryRisk": { "$ref": "#/$defs/qualitativeLevel" },
        "priceExposure": { "$ref": "#/$defs/qualitativeLevel" },
        "accessExposure": { "$ref": "#/$defs/qualitativeLevel" },
        "controlPointRef": { "type": ["string", "null"] },
        "shockgraphDependencyRef": { "type": ["string", "null"] },
        "epistemicState": { "$ref": "#/$defs/epistemicState" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" },
        "counterEvidenceRefs": { "$ref": "#/$defs/sourceRefs" }
      },
      "additionalProperties": false
    },
    "switchingProcess": {
      "type": "object",
      "required": [
        "dataMigration",
        "integrationRebuild",
        "userTraining",
        "workflowChange",
        "contractCost",
        "networkLoss",
        "historicalContextLoss",
        "organizationalPolitics",
        "riskTrust",
        "searchCost"
      ],
      "properties": {
        "dataMigration": { "$ref": "#/$defs/nonEmptyString" },
        "integrationRebuild": { "$ref": "#/$defs/nonEmptyString" },
        "userTraining": { "$ref": "#/$defs/nonEmptyString" },
        "workflowChange": { "$ref": "#/$defs/nonEmptyString" },
        "contractCost": { "$ref": "#/$defs/nonEmptyString" },
        "networkLoss": { "$ref": "#/$defs/nonEmptyString" },
        "historicalContextLoss": { "$ref": "#/$defs/nonEmptyString" },
        "organizationalPolitics": { "$ref": "#/$defs/nonEmptyString" },
        "riskTrust": { "$ref": "#/$defs/nonEmptyString" },
        "searchCost": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "multiHoming": {
      "type": "object",
      "required": ["allowed", "sides", "friction", "cost", "portability", "networkStateLoss"],
      "properties": {
        "allowed": { "enum": ["YES", "NO", "CONDITIONAL", "NOT_APPLICABLE", "UNKNOWN"] },
        "sides": { "$ref": "#/$defs/stringArray" },
        "friction": { "$ref": "#/$defs/qualitativeLevel" },
        "cost": { "$ref": "#/$defs/nonEmptyString" },
        "portability": { "$ref": "#/$defs/nonEmptyString" },
        "networkStateLoss": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "ecosystemEdge": {
      "type": "object",
      "required": ["edgeId", "fromActorRef", "toActorRef", "type", "marketRefs", "mechanism", "epistemicState", "sourceRefs"],
      "properties": {
        "edgeId": { "type": "string", "pattern": "^edge-[a-z0-9-]+$" },
        "fromActorRef": { "type": "string" },
        "toActorRef": { "type": "string" },
        "type": {
          "enum": [
            "BUYS_FROM",
            "SELLS_TO",
            "DEPENDS_ON",
            "COMPETES_WITH",
            "COMPLEMENTS",
            "BUNDLES",
            "DISTRIBUTES",
            "SUPPLIES",
            "CONTROLS_ACCESS_TO",
            "INTEROPERATES_WITH",
            "SUBSTITUTES",
            "REGULATES",
            "SETS_STANDARD_FOR",
            "INTEGRATES_WITH"
          ]
        },
        "marketRefs": { "$ref": "#/$defs/stringArray" },
        "mechanism": { "$ref": "#/$defs/nonEmptyString" },
        "epistemicState": { "$ref": "#/$defs/epistemicState" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "responseId",
        "actorRef",
        "targetActorRefs",
        "trigger",
        "triggerEventRefs",
        "possibleAction",
        "ability",
        "abilityMechanism",
        "incentive",
        "incentiveMechanism",
        "timeToExecute",
        "likelyImpact",
        "constraints",
        "countermoves",
        "epistemicState",
        "sourceRefs",
        "counterEvidenceRefs",
        "falsifier"
      ],
      "properties": {
        "responseId": { "type": "string", "pattern": "^response-[a-z0-9-]+$" },
        "actorRef": { "type": "string" },
        "targetActorRefs": { "$ref": "#/$defs/nonEmptyStringArray" },
        "trigger": { "$ref": "#/$defs/nonEmptyString" },
        "triggerEventRefs": { "$ref": "#/$defs/stringArray" },
        "possibleAction": {
          "enum": [
            "IGNORE",
            "COPY_FEATURE",
            "LOWER_PRICE",
            "MAKE_FEATURE_FREE",
            "BUNDLE",
            "ACQUIRE",
            "PARTNER",
            "BLOCK_ACCESS",
            "CHANGE_API",
            "RAISE_API_PRICE",
            "SELF_PREFERENCE",
            "ENTER_ADJACENT_MARKET",
            "OPEN_SOURCE",
            "CLOSE_SOURCE",
            "INCREASE_INTEGRATION",
            "SIGN_EXCLUSIVITY",
            "INCREASE_MARKETING",
            "LEVERAGE_SALES_FORCE",
            "SEEK_STANDARD",
            "INTEROPERATE",
            "DISINTERMEDIATE",
            "UNKNOWN"
          ]
        },
        "ability": { "$ref": "#/$defs/qualitativeLevel" },
        "abilityMechanism": { "$ref": "#/$defs/nonEmptyString" },
        "incentive": { "$ref": "#/$defs/qualitativeLevel" },
        "incentiveMechanism": { "$ref": "#/$defs/nonEmptyString" },
        "timeToExecute": { "$ref": "#/$defs/timeHorizon" },
        "likelyImpact": { "$ref": "#/$defs/nonEmptyString" },
        "constraints": { "$ref": "#/$defs/nonEmptyStringArray" },
        "countermoves": { "$ref": "#/$defs/stringArray" },
        "epistemicState": { "$ref": "#/$defs/epistemicState" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" },
        "counterEvidenceRefs": { "$ref": "#/$defs/sourceRefs" },
        "falsifier": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "strategicClaim": {
      "type": "object",
      "required": [
        "claimId",
        "subject",
        "claim",
        "epistemicState",
        "mechanism",
        "actorRef",
        "controlPointRef",
        "asset",
        "beneficiaries",
        "disadvantaged",
        "conditions",
        "evidenceRefs",
        "counterEvidenceRefs",
        "timeHorizon",
        "falsifier",
        "asOf",
        "confidence",
        "status",
        "contradictionStatus",
        "resolution"
      ],
      "properties": {
        "claimId": { "type": "string", "pattern": "^STR-[A-Z0-9-]+$" },
        "subject": { "$ref": "#/$defs/nonEmptyString" },
        "claim": { "$ref": "#/$defs/nonEmptyString" },
        "epistemicState": { "$ref": "#/$defs/epistemicState" },
        "mechanism": { "$ref": "#/$defs/nonEmptyString" },
        "actorRef": { "type": "string" },
        "controlPointRef": { "type": ["string", "null"] },
        "asset": { "$ref": "#/$defs/nonEmptyString" },
        "beneficiaries": { "$ref": "#/$defs/nonEmptyStringArray" },
        "disadvantaged": { "$ref": "#/$defs/nonEmptyStringArray" },
        "conditions": { "$ref": "#/$defs/nonEmptyStringArray" },
        "evidenceRefs": { "$ref": "#/$defs/sourceRefs" },
        "counterEvidenceRefs": { "$ref": "#/$defs/sourceRefs" },
        "timeHorizon": { "$ref": "#/$defs/timeHorizon" },
