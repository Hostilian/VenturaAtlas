{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ventureatlas.local/schemas/commercial-outcome-receipt.schema.json",
  "title": "Private commercial outcome receipt",
  "description": "One immutable, digest-bound commercial observation. Structural validity does not turn operator attestation into independent proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "subject",
    "organizationRef",
    "opportunityRef",
    "eventType",
    "occurredAt",
    "recordedAt",
    "recordedBy",
    "predecessorReceiptId",
    "predecessorReceiptDigest",
    "evidence",
    "transaction",
    "receiptDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "receiptId": {
      "type": "string",
      "pattern": "^commercial-receipt-[a-z0-9][a-z0-9-]{2,120}$"
    },
    "subject": { "$ref": "#/$defs/subject" },
    "organizationRef": {
      "type": "string",
      "pattern": "^org-[a-z0-9][a-z0-9-]{2,120}$"
    },
    "opportunityRef": {
      "type": "string",
      "pattern": "^opportunity-[a-z0-9][a-z0-9-]{2,120}$"
    },
    "eventType": {
      "enum": [
        "OPPORTUNITY_OPENED",
        "OFFER_ACCEPTED",
        "PILOT_STARTED",
        "PAYMENT_SETTLED",
        "REFUND_SETTLED",
        "VALUE_ACHIEVED",
        "REPEAT_OR_RENEWAL_COMMITTED",
        "REPEAT_PAYMENT_SETTLED",
        "EXPANSION_COMMITTED",
        "EXPANSION_PAYMENT_SETTLED",
        "REFERRAL_CONFIRMED",
        "REJECTION_RECORDED",
        "CHURN_RECORDED"
      ]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "recordedBy": {
      "type": "string",
      "pattern": "^operator-[a-z0-9][a-z0-9-]{2,120}$"
    },
    "predecessorReceiptId": {
      "type": ["string", "null"],
      "pattern": "^commercial-receipt-[a-z0-9][a-z0-9-]{2,120}$"
    },
    "predecessorReceiptDigest": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "transaction": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/transaction" }
      ]
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "contentDigest", "lineageRef"],
      "properties": {
        "kind": { "enum": ["CANONICAL_IDEA", "STAGED_CANDIDATE"] },
        "id": { "type": "string" },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lineageRef": {
          "type": "string",
          "pattern": "^lineage-[a-z0-9][a-z0-9-]{2,160}$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "CANONICAL_IDEA" } } },
          "then": { "properties": { "id": { "pattern": "^idea-[0-9]{3}$" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "STAGED_CANDIDATE" } } },
          "then": {
            "properties": {
              "id": { "pattern": "^(?:candidate|staged)-[a-z0-9][a-z0-9-]{2,160}$" }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "kind",
        "verification",
        "privateRef",
        "sha256",
        "issuerRef"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "pattern": "^evidence-[a-z0-9][a-z0-9-]{2,140}$"
        },
        "kind": {
          "enum": [
            "OPERATOR_ATTESTATION",
            "SIGNED_AGREEMENT",
            "PRODUCTION_PAYMENT_PROVIDER",
            "BANK_STATEMENT",
            "AUTHORIZED_PRODUCT_TELEMETRY",
            "CUSTOMER_COMMUNICATION"
          ]
        },
        "verification": {
          "enum": ["OPERATOR_ATTESTED", "INDEPENDENTLY_VERIFIABLE"]
        },
        "privateRef": {
          "type": "string",
          "pattern": "^private-evidence-[a-z0-9][a-z0-9-]{2,160}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "issuerRef": {
          "type": "string",
          "pattern": "^issuer-[a-z0-9][a-z0-9-]{2,120}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "OPERATOR_ATTESTATION" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "verification": { "const": "OPERATOR_ATTESTED" } }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["PRODUCTION_PAYMENT_PROVIDER", "BANK_STATEMENT"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": { "verification": { "const": "INDEPENDENTLY_VERIFIABLE" } }
          }
        }
      ]
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "amountMinor",
        "currency",
        "status",
        "provider",
        "providerEventId",
        "providerEventDigest",
        "environment",
        "relatedPaymentReceiptId"
      ],
      "properties": {
        "kind": { "enum": ["PAYMENT", "REFUND"] },
        "amountMinor": { "type": "integer", "minimum": 1 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "status": { "const": "SETTLED" },
        "provider": {
          "enum": ["STRIPE", "ADYEN", "PAYPAL", "BANK_TRANSFER", "OTHER_PRODUCTION_PROVIDER"]
        },
        "providerEventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{5,180}$"
        },
        "providerEventDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment": { "const": "PRODUCTION" },
        "relatedPaymentReceiptId": {
          "type": ["string", "null"],
          "pattern": "^commercial-receipt-[a-z0-9][a-z0-9-]{2,120}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "eventType": { "const": "OPPORTUNITY_OPENED" } },
        "required": ["eventType"]
      },
      "then": {
        "properties": {
          "predecessorReceiptId": { "type": "null" },
          "predecessorReceiptDigest": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "predecessorReceiptId": { "type": "string" },
          "predecessorReceiptDigest": { "type": "string" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "enum": [
              "PAYMENT_SETTLED",
              "REFUND_SETTLED",
              "REPEAT_PAYMENT_SETTLED",
              "EXPANSION_PAYMENT_SETTLED"
            ]
          }
        },
        "required": ["eventType"]
      },
      "then": {
        "properties": {
          "transaction": { "$ref": "#/$defs/transaction" },
          "evidence": {
            "contains": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": ["PRODUCTION_PAYMENT_PROVIDER", "BANK_STATEMENT"]
                },
                "verification": { "const": "INDEPENDENTLY_VERIFIABLE" }
              },
              "required": ["kind", "verification"]
            },
            "minContains": 1
          }
        }
      },
      "else": { "properties": { "transaction": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "eventType": { "const": "PAYMENT_SETTLED" } },
        "required": ["eventType"]
      },
      "then": {
        "properties": {
          "transaction": {
            "allOf": [
              { "$ref": "#/$defs/transaction" },
              {
                "properties": {
                  "kind": { "const": "PAYMENT" },
                  "relatedPaymentReceiptId": { "type": "null" }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "eventType": { "const": "REFUND_SETTLED" } },
        "required": ["eventType"]
      },
      "then": {
        "properties": {
          "transaction": {
            "allOf": [
              { "$ref": "#/$defs/transaction" },
              {
                "properties": {
                  "kind": { "const": "REFUND" },
                  "relatedPaymentReceiptId": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "enum": ["REPEAT_PAYMENT_SETTLED", "EXPANSION_PAYMENT_SETTLED"]
          }
        },
        "required": ["eventType"]
      },
      "then": {
        "properties": {
          "transaction": {
            "allOf": [
              { "$ref": "#/$defs/transaction" },
              {
                "properties": {
                  "kind": { "const": "PAYMENT" },
                  "relatedPaymentReceiptId": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "eventType": { "const": "VALUE_ACHIEVED" } },
        "required": ["eventType"]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "SIGNED_AGREEMENT",
                    "AUTHORIZED_PRODUCT_TELEMETRY",
                    "CUSTOMER_COMMUNICATION"
                  ]
                },
                "verification": { "const": "INDEPENDENTLY_VERIFIABLE" }
              },
              "required": ["kind", "verification"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": { "eventType": { "const": "REFERRAL_CONFIRMED" } },
        "required": ["eventType"]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "type": "object",
              "properties": {
                "kind": { "const": "CUSTOMER_COMMUNICATION" },
                "verification": { "const": "INDEPENDENTLY_VERIFIABLE" }
              },
              "required": ["kind", "verification"]
            },
            "minContains": 1
          }
        }
      }
    }
  ]
}
