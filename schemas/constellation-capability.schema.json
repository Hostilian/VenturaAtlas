{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ventureatlas.local/schemas/constellation-capability.schema.json",
  "title": "Constellation Capability Specification",
  "description": "Ontology of organizational capabilities required for venture execution separate from individual people.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilityId",
    "name",
    "domain",
    "description",
    "evidenceOfMastery"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "capabilityId": { "type": "string", "pattern": "^cap-[a-z0-9-]+$" },
    "name": { "type": "string" },
    "domain": {
      "type": "string",
      "enum": [
        "ENGINEERING_ARCHITECTURE",
        "PRODUCT_DESIGN_UX",
        "COMMERCIAL_DISCOVERY_SALES",
        "GROWTH_DEMAND_GEN",
        "OPERATIONS_SUPPORT",
        "FINANCE_CAPITAL",
        "LEGAL_COMPLIANCE",
        "AI_EVALUATION_SYSTEMS",
        "DOMAIN_SPECIALIST"
      ]
    },
    "description": { "type": "string" },
    "evidenceOfMastery": { "type": "string" },
    "isSopDocumentable": { "type": "boolean" },
    "isAiAutomatable": { "type": "boolean" }
  }
}
