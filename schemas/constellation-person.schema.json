{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ventureatlas.local/schemas/constellation-person.schema.json",
  "title": "Constellation Minimal Person Specification",
  "description": "Private, minimal organizational record of a founder, team member, contractor, or advisor without invasive productivity surveillance or protected traits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "personId",
    "displayName",
    "relationship",
    "assignedRoleIds",
    "totalWeeklyCapacityHours",
    "roleAllocationsPercent"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "personId": { "type": "string", "pattern": "^person-[a-z0-9-]+$" },
    "displayName": { "type": "string" },
    "relationship": {
      "type": "string",
      "enum": ["FOUNDER", "CO_FOUNDER", "EMPLOYEE", "CONTRACTOR", "FRACTIONAL_EXECUTIVE", "ADVISOR", "AI_AGENT_WORKER"]
    },
    "assignedRoleIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "capabilitiesPossessed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "totalWeeklyCapacityHours": { "type": "number", "minimum": 1, "maximum": 80 },
    "roleAllocationsPercent": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roleId", "allocationPercent"],
        "properties": {
          "roleId": { "type": "string" },
          "allocationPercent": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "knownKnowledgeDomains": {
      "type": "array",
      "items": { "type": "string" }
    },
    "accessScope": {
      "type": "string",
      "enum": ["FULL_FOUNDER_ADMIN", "CORE_OPERATIONS", "DOMAIN_SPECIFIC", "READ_ONLY_REVIEW", "SANDBOX"]
    },
    "updatedAt": { "type": "string" }
  }
}
