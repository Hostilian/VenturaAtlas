{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://venture-atlas.example/schemas/test-scenario.schema.json",
  "title":"ProofOps TestScenario",
  "type":"object",
  "required":["scenarioId","name","subjectType","steps","passCondition","failCondition"],
  "properties":{"scenarioId":{"type":"string","pattern":"^scenario-[a-z0-9-]+$"},"name":{"type":"string"},"subjectType":{"type":"string"},"steps":{"type":"array","minItems":1,"items":{"type":"object","required":["stepId","action","expected"],"properties":{"stepId":{"type":"string"},"action":{"type":"string"},"expected":{"type":"string"}},"additionalProperties":false}},"passCondition":{"type":"string"},"failCondition":{"type":"string"},"version":{"type":"string"}},
  "additionalProperties":false
}
