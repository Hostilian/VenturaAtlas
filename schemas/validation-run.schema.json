{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["runId", "ideaId", "ideaContentDigest", "status", "evidenceKind", "startedAt", "endedAt", "evidenceRefs"],
  "properties": {
    "runId": { "type": "string", "pattern": "^validation-[a-z0-9-]+$" },
    "ideaId": { "type": "string", "pattern": "^idea-[0-9]{3}$" },
    "ideaContentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "const": "COMPLETED" },
    "evidenceKind": { "enum": ["BEHAVIORAL", "TRANSACTIONAL"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
